# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 蓝河应用签名私钥 —— 泄露即可被他人冒名打包, 绝不入库
watch/sign/
*.pem

# Python 缓存 (watch/proxy 的转发服务)
__pycache__/
*.pyc

# 手表端本机配置 (转发服务地址 / Supabase 项目地址与 key)
# 从 watch/src/config.example.js 复制一份填自己的值
watch/src/config.js

# 私人资料 (机器路径、内网 IP、脱敏对照表、重写前的中文提交历史)
# 这个目录整个不入库, 详见 private/README.md
/private/
