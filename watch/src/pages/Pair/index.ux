<template>
  <div
    class="page"
    id="root"
    focusable="true"
    rotation-sensitivity="1"
    @rotation="onRotation"
  >
    <text class="title" onlongpress="netTest">输入配对码</text>
    <text class="sub">网页「手表」页生成</text>

    <!-- 6 位数字: 转表冠改当前位, 点击切换位 -->
    <div class="code-row">
      <div class="{{ $item.cls }}" for="{{ cells }}" onclick="pick($idx)">
        <text class="{{ $item.textCls }}">{{ $item.d }}</text>
      </div>
    </div>

    <text class="err">{{ err }}</text>

    <div class="{{ btnCls }}" onclick="submit">
      <text class="btn-text">{{ btnText }}</text>
    </div>
  </div>
</template>

<script>
  import * as api from '../../common/api.js'
  import * as store from '../../common/store.js'
  import * as device from '../../common/device.js'

  // 表冠节流: 攒够这么多步进才跳一格, 数值越大越迟钝。
  // 3 实测仍偏灵敏, 取 8; 嫌迟钝就往下调, 这是唯一的调节旋钮。
  const ROTATE_STEP = 8
  let rotateAcc = 0

  export default {
    // 蓝河只认 data —— private/protected/public 在真机上不生效,
    // 声明在里面的字段全部会是 undefined(三个开源蓝河应用均只用 data)
    data: {
      digits: [0, 0, 0, 0, 0, 0],
      idx: 0,
      cells: [],
      err: '',
      busy: false,
      hasErr: false,
      // 模板专用派生字段, 理由同 Today 页
      btnCls: 'btn',
      btnText: '确认',
    },

    onInit() {
      this.refresh()
      // 进页面就自检一次: fetch 拿不到的话直接把模块结构显示出来
      if (!api.networkAvailable()) this.err = api.diagText()
    },

    onReady() {
      const el = this.$element('root')
      if (el && el.requestFocus) el.requestFocus(true)
    },

    refresh() {
      const list = []
      for (let i = 0; i < 6; i++) {
        const on = i === this.idx
        list.push({
          d: String(this.digits[i]),
          on: on,
          cls: on ? 'cell cell-on' : 'cell',
          textCls: on ? 'cell-text cell-text-on' : 'cell-text',
        })
      }
      this.cells = list
    },

    /**
     * 转表冠: 0-9 循环
     * 每来一个事件就跳一格会过于灵敏, 手一抖就冲过头。这里累积旋转量,
     * 攒够 ROTATE_STEP 才动一格; 计数放模块级变量, 不进 data(不参与渲染)。
     */
    onRotation(e) {
      if (!e || e.state === 3) return
      let d = e.delta
      if (!d) d = e.direction ? -1 : 1

      // 反向时立即清零, 免得残留的反向累积让第一下没反应
      if ((d > 0) !== (rotateAcc > 0)) rotateAcc = 0
      rotateAcc += d
      if (Math.abs(rotateAcc) < ROTATE_STEP) return
      const dir = rotateAcc > 0 ? 1 : -1
      rotateAcc = 0

      let v = this.digits[this.idx] + dir
      if (v > 9) v = 0
      if (v < 0) v = 9
      this.digits[this.idx] = v
      this.refresh()
    },

    pick(i) {
      this.idx = i
      this.refresh()
    },

    /** 长按标题触发: 网络自检, 结果直接显示在错误区 */
    netTest() {
      const self = this
      self.err = '自检中…'
      api.selfTest().then(function (txt) {
        self.err = txt
      })
    },

    setBusy(v) {
      this.busy = v
      this.btnCls = v ? 'btn btn-off' : 'btn'
      this.btnText = v ? '配对中…' : '确认'
    },

    submit() {
      if (this.busy) return
      const code = this.digits.join('')
      this.setBusy(true)
      this.err = ''
      const self = this

      api
        .redeemCode(code)
        .then(function (token) {
          // token 是 64 位十六进制; 长度不对说明返回值被框架处理成了别的东西
          if (!token || token.length < 32) {
            self.setBusy(false)
            self.err = '返回异常 len=' + (token ? token.length : 0)
            return
          }
          return store.setToken(token).then(function (ok) {
            if (!ok) {
              self.setBusy(false)
              self.err = '保存失败 ' + store.storageDiag()
              return
            }
            // 写后立刻读回来确认 —— 否则跳过去才发现没存住, 又得重配一次
            return store.getToken().then(function (back) {
              if (!back) {
                self.setBusy(false)
                self.err = '存了读不回 ' + store.storageDiag()
                return
              }
              device.vibrate()
              self.setBusy(false)
              // replace: 免得用户按返回又回到配对页
              device.replace('/pages/Today')
            })
          })
        })
        .catch(function (e) {
          self.setBusy(false)
          const m = (e && e.message) || '未知错误'
          if (m.indexOf('code invalid') >= 0) {
            // 后端对过期/用过的码统一抛 code invalid or expired
            self.err = '配对码无效或已过期'
          } else if (m.indexOf('fetch模块') >= 0) {
            // 直接把模块真实结构摆到屏幕上, 省得去翻 DevTools
            self.err = api.diagText()
          } else {
            // 其余一律原样显示 —— 手表上没有别的排查手段
            self.err = m.substring(0, 46)
          }
        })
    },
  }
</script>

<style>
  .page {
    flex-direction: column;
    width: 466px;
    height: 466px;
    background-color: #000000;
    align-items: center;
  }
  .title {
    margin-top: 74px;
    font-size: 32px;
    color: #ffffff;
  }
  .sub {
    margin-top: 6px;
    font-size: 22px;
    color: #8a8a8e;
  }

  .code-row {
    flex-direction: row;
    margin-top: 30px;
    justify-content: center;
  }
  .cell {
    width: 54px;
    height: 72px;
    margin-left: 4px;
    margin-right: 4px;
    border-radius: 10px;
    background-color: #1c1c1e;
    align-items: center;
    justify-content: center;
  }
  .cell-on {
    background-color: #00e5a0;
  }
  .cell-text {
    font-size: 36px;
    color: #ffffff;
  }
  .cell-text-on {
    color: #000000;
  }

  .err {
    margin-top: 10px;
    width: 410px;
    font-size: 17px;
    color: #ff453a;
    text-align: center;
    lines: 4;
    text-overflow: ellipsis;
  }

  .btn {
    margin-top: 12px;
    width: 220px;
    height: 72px;
    border-radius: 36px;
    background-color: #00e5a0;
    align-items: center;
    justify-content: center;
  }
  .btn-off {
    background-color: #1c1c1e;
  }
  .btn-text {
    font-size: 28px;
    color: #000000;
  }
</style>
