<template>
  <div class="page">
    <!-- ============ 加载中 ============ -->
    <div if="{{ stage === 'loading' }}" class="center">
      <text class="hint">载入中…</text>
    </div>

    <!-- ============ 未配对 ============ -->
    <div elif="{{ stage === 'unpaired' }}" class="center">
      <text class="big-icon">⌚</text>
      <text class="title-sm">还没配对</text>
      <text class="hint">在网页「手表」页生成配对码</text>
      <div class="btn" onclick="goPair">
        <text class="btn-text">去配对</text>
      </div>
      <text if="{{ pairHint }}" class="err-hint">{{ pairHint }}</text>
    </div>

    <!-- ============ 选择训练日 ============ -->
    <div elif="{{ stage === 'pickday' }}" class="wrap">
      <div class="header">
        <text class="head-title">选择训练日</text>
      </div>
      <list class="list" id="daylist">
        <list-item type="day" class="day-item" for="{{ weekdays }}" onclick="chooseDay($idx)">
          <text class="day-text {{ $item.current ? 'day-on' : '' }}">{{ $item.label }}</text>
        </list-item>
      </list>
    </div>

    <!-- ============ 今日计划 ============ -->
    <div else class="wrap">
      <!--
        顶部只留训练日名称, 进度交给下面那条绿条表达 —— 圆屏上少一个数字
        就能给标题让出整整一行宽度。长按可切换训练日。

        标题过长时用 marquee 滚动完整显示; 够短就用普通 text, 免得没必要地动。
        scrollamount 实测偏快(文档称每秒像素数, 实际更接近每帧步进), 取 6 为宜;
        嫌快继续往下调, 嫌慢往上调, 改这一个数字即可。
        loop=3 滚三遍即停, 不持续占帧率; 两端阴影默认开且为黑色, 与背景融合。
      -->
      <div class="header" onlongpress="openPickDay">
        <marquee
          if="{{ titleScroll }}"
          class="head-title-mq"
          scrollamount="6"
          loop="3"
          text-offset="80"
        >{{ title }}</marquee>
        <text else class="head-title">{{ title }}</text>
      </div>
      <!-- 进度条: 唯一的强调色, 一眼看出还剩几个 -->
      <div class="bar-bg">
        <div class="bar-fill" style="width: {{ barWidth }}px;"></div>
      </div>

      <!-- 离线/同步状态, 只在有异常时占位 -->
      <text if="{{ banner }}" class="banner" onclick="boot">{{ banner }}</text>

      <!-- 今天没有安排 -->
      <div if="{{ totalCount === 0 }}" class="center-rest">
        <text class="big-icon">🌙</text>
        <text class="hint">今天休息</text>
        <text class="hint-sm">长按标题可切换训练日</text>
      </div>

      <!-- 动作列表 -->
      <list else class="list" id="exlist">
        <list-item type="ex" class="item" for="{{ exercises }}" onclick="openRecord($idx)">
          <!--
            用 CSS 画圆而不是打 ✓ / ○ 字符 —— 手表的精简字体不一定收录这些符号,
            缺字时会渲染成方块。未完成=灰色空心圈, 已完成=强调色实心圆。
          -->
          <div class="dot-wrap">
            <div class="dot {{ $item.done ? 'dot-on' : '' }}"></div>
          </div>
          <div class="item-body">
            <text class="item-name {{ $item.done ? 'item-name-done' : '' }}">{{ $item.exercise }}</text>
            <text class="item-sub">{{ $item.subtitle }}</text>
          </div>
        </list-item>
      </list>
    </div>
  </div>
</template>

<script>
  import * as store from '../../common/store.js'
  import * as sync from '../../common/sync.js'
  import * as api from '../../common/api.js'
  import * as device from '../../common/device.js'

  const WEEK_LABEL = ['周一', '周二', '周三', '周四', '周五', '周六', '周日']

  /**
   * 去掉 numeric 带来的多余小数: 60.00 -> 60, 62.50 -> 62.5
   * 不用全局 isFinite —— 精简 JS 运行时未必提供, 自己判 NaN/Infinity 更保险
   */
  function fmtNum(v) {
    if (v === null || v === undefined || v === '') return ''
    const n = Number(v)
    if (n !== n || n === Infinity || n === -Infinity) return ''
    return String(Math.round(n * 100) / 100)
  }

  /** 列表第二行: 已完成显示实际做的, 未完成显示计划目标 */
  function buildSubtitle(e) {
    if (e.done) {
      const w = fmtNum(e.done_weight_kg)
      const parts = []
      if (w) parts.push(w + 'kg')
      if (e.done_sets && e.done_reps) parts.push(e.done_sets + '×' + e.done_reps)
      else if (e.done_reps) parts.push(e.done_reps + '次')
      if (e.done_rir !== null && e.done_rir !== undefined) parts.push('RIR' + e.done_rir)
      return parts.join('  ')
    }
    const parts = []
    // 显示历史最大重量(与记录页的预填值一致), 而不是上次那条 ——
    // 上次可能是减量周或状态差, 最好成绩更贴近「今天要冲多少」
    const bw = fmtNum(e.max_weight_kg)
    if (bw) parts.push(bw + 'kg')
    if (e.target_sets) {
      let reps = ''
      if (e.rep_min && e.rep_max) {
        reps = e.rep_min === e.rep_max ? String(e.rep_min) : e.rep_min + '-' + e.rep_max
      } else if (e.rep_min) {
        reps = String(e.rep_min)
      }
      parts.push(reps ? e.target_sets + '×' + reps : e.target_sets + '组')
    }
    return parts.join('  ')
  }

  export default {
    private: {
      stage: 'loading', // loading | unpaired | pickday | ready
      token: '',
      title: '',
      doneCount: 0,
      totalCount: 0,
      barWidth: 0,
      exercises: [],
      banner: '',
      weekday: null, // null = 跟随今天; 1..7 = 手动指定
      weekdays: [],
      pairHint: '',
      titleScroll: false,
    },

    // 标题栏由 manifest.json 的 display.titleBar 控制, 不在代码里调
    onShow() {
      // 每次回到本页都重新拉一次 —— 从记录页返回后进度要立刻更新
      this.boot()
    },

    boot() {
      const self = this
      store.getToken().then(function (token) {
        if (!token) {
          self.stage = 'unpaired'
          return
        }
        self.token = token
        self.load()
      })
    },

    load() {
      const self = this
      if (self.stage !== 'pickday') self.stage = 'ready'
      self.banner = ''

      sync
        .loadToday(self.token, self.weekday, function (payload, fromCache) {
          self.applyPlan(payload)
          if (fromCache) self.banner = '离线数据'
        })
        .then(function () {
          self.banner = ''
          // 顺手把攒下的离线记录补传
          return sync.flushPending(self.token).then(function (n) {
            if (n > 0) {
              self.banner = '已补传 ' + n + ' 条'
              // 补传后服务端状态变了, 重新拉一次
              return api.getToday(self.token, self.weekday).then(function (p) {
                self.applyPlan(p)
              })
            }
          })
        })
        .catch(function (err) {
          if (api.isUnpaired(err)) {
            store.clearToken()
            self.stage = 'unpaired'
            return
          }
          // 有缓存就继续用, 只做轻提示; 没缓存时把真实错误显示出来,
          // 否则「连不上」三个字什么也说明不了
          console.log(
            '[today] load 失败: ' + (err && err.message) +
              ' | stack=' + (err && err.stack)
          )
          if (self.totalCount > 0) {
            self.banner = '离线中'
          } else {
            const m = (err && err.message) || '未知错误'
            // 把 stack 首行也带上, 直接指出出错位置
            const st = err && err.stack ? String(err.stack).split('\n')[0] : ''
            self.banner = (String(m) + ' @' + st).substring(0, 60) + ' (点此重试)'
          }
        })
    },

    // 注意: 方法名不能叫 render —— 那是框架渲染引擎的保留名, 会被覆盖成非函数
    applyPlan(payload) {
      if (!payload) return
      try {
        const list = payload.exercises || []
        for (let i = 0; i < list.length; i++) {
          list[i].subtitle = buildSubtitle(list[i])
        }

        this.title = payload.title || '今天'
        // 去掉进度数字后标题独占 386px, 32px 字号约容 12 个汉字
        this.titleScroll = this.title.length > 12
        this.doneCount = payload.done_count || 0
        this.totalCount = payload.total_count || 0
        this.exercises = list
        // 进度条总宽 386px (466 - 左右各 40)
        this.barWidth = this.totalCount
          ? Math.round((386 * this.doneCount) / this.totalCount)
          : 0

        console.log(
          '[today] applyPlan 完成 ' + this.doneCount + '/' + this.totalCount
        )
      } catch (e) {
        // 出问题时才输出完整堆栈, 平时不占日志
        console.log('[today] applyPlan 异常: ' + e + ' | stack=' + (e && e.stack))
        throw e
      }
    },

    // ---------------- 交互 ----------------

    openRecord(idx) {
      const e = this.exercises[idx]
      if (!e) return
      device.push('/pages/Record', {
        exercise: e.exercise,
        workoutDay: this.title,
        // 预填重量: 已记录过用今天实际值, 否则用历史最大重量, 从没练过则 0
        weight: fmtNum(e.done ? e.done_weight_kg : e.max_weight_kg) || '0',
        sets: String(e.done ? e.done_sets || 0 : e.target_sets || e.last_sets || 3),
        reps: String(e.done ? e.done_reps || 0 : e.rep_min || e.last_reps || 8),
        rir: String(
          e.done && e.done_rir !== null && e.done_rir !== undefined
            ? e.done_rir
            : e.rir_min !== null && e.rir_min !== undefined
              ? e.rir_min
              : 2
        ),
      })
    },

    openPickDay() {
      const cur = this.weekday || sync.todayWeekday()
      const days = []
      for (let i = 1; i <= 7; i++) {
        days.push({ label: WEEK_LABEL[i - 1], value: i, current: i === cur })
      }
      this.weekdays = days
      this.stage = 'pickday'
    },

    chooseDay(idx) {
      const d = this.weekdays[idx]
      if (!d) return
      // 选中今天就恢复成「跟随今天」, 免得跨天后还停在旧的训练日
      this.weekday = d.value === sync.todayWeekday() ? null : d.value
      this.stage = 'ready'
      this.load()
    },

    goPair() {
      if (!device.push('/pages/Pair')) {
        // 路由模块没拿到时不要静默失败, 否则表现为「按钮点不动」
        this.pairHint = '路由不可用, 请查看 DevTools 日志'
      }
    },
  }
</script>

<style>
  .page {
    flex-direction: column;
    width: 466px;
    height: 466px;
    background-color: #000000;
  }

  .wrap {
    flex-direction: column;
    width: 466px;
    height: 466px;
  }

  /* ---------- 居中态: 加载 / 未配对 ---------- */
  .center {
    flex-direction: column;
    width: 466px;
    height: 466px;
    align-items: center;
    justify-content: center;
  }
  .center-rest {
    flex-direction: column;
    width: 466px;
    height: 300px;
    align-items: center;
    justify-content: center;
  }
  .big-icon {
    font-size: 72px;
    margin-bottom: 16px;
  }
  .title-sm {
    font-size: 32px;
    color: #ffffff;
    margin-bottom: 8px;
  }
  .hint {
    font-size: 26px;
    color: #8a8a8e;
    text-align: center;
  }
  .hint-sm {
    font-size: 22px;
    color: #48484a;
    margin-top: 10px;
  }
  .btn {
    margin-top: 28px;
    width: 220px;
    height: 72px;
    border-radius: 36px;
    background-color: #00e5a0;
    align-items: center;
    justify-content: center;
  }
  .err-hint {
    margin-top: 16px;
    width: 380px;
    font-size: 20px;
    color: #ff453a;
    text-align: center;
  }
  .btn-text {
    font-size: 28px;
    color: #000000;
  }

  /* ---------- 顶部 ---------- */
  .header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 386px;
    margin-left: 40px;
    margin-top: 46px;
    height: 48px;
  }
  .head-title {
    font-size: 32px;
    color: #ffffff;
    lines: 1;
    text-overflow: ellipsis;
    flex: 1;
  }
  /* 跑马灯: 与静态标题同字号同色, 切换时视觉上无跳变 */
  .head-title-mq {
    flex: 1;
    height: 44px;
    font-size: 32px;
    color: #ffffff;
  }

  .bar-bg {
    width: 386px;
    height: 6px;
    margin-left: 40px;
    margin-top: 10px;
    border-radius: 3px;
    background-color: #1c1c1e;
  }
  .bar-fill {
    height: 6px;
    border-radius: 3px;
    background-color: #00e5a0;
  }

  .banner {
    width: 386px;
    margin-left: 40px;
    margin-top: 8px;
    font-size: 19px;
    color: #8a8a8e;
    text-align: center;
    lines: 2;
    text-overflow: ellipsis;
  }

  /* ---------- 列表 ---------- */
  .list {
    width: 466px;
    flex: 1;
    margin-top: 8px;
    padding-bottom: 40px;
  }
  .item {
    flex-direction: row;
    align-items: center;
    width: 466px;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .dot-wrap {
    width: 44px;
    align-items: center;
    justify-content: center;
  }
  /* CSS 画的圆点, 不依赖字体是否收录 ✓ / ○ */
  .dot {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    border-width: 2px;
    border-color: #48484a;
    background-color: #000000;
  }
  .dot-on {
    border-color: #00e5a0;
    background-color: #00e5a0;
  }
  .item-body {
    flex-direction: column;
    flex: 1;
  }
  .item-name {
    font-size: 30px;
    color: #ffffff;
    lines: 1;
    text-overflow: ellipsis;
  }
  .item-name-done {
    color: #8a8a8e;
  }
  .item-sub {
    font-size: 22px;
    color: #8a8a8e;
    margin-top: 4px;
    lines: 1;
    text-overflow: ellipsis;
  }

  /* ---------- 选择训练日 ---------- */
  .day-item {
    width: 466px;
    height: 76px;
    align-items: center;
    justify-content: center;
  }
  .day-text {
    font-size: 30px;
    color: #ffffff;
  }
  .day-on {
    color: #00e5a0;
  }
</style>
